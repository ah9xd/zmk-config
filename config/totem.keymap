            timeout-ms = <50>;
            layers = <0 2 3 4 6 7>;
        };

        combo_rgui {
            key-positions = <19 30>;
            bindings = <&sk RGUI>;
            timeout-ms = <50>;
            layers = <0 2 3 4 6 7>;
        };

        combo_lshft {
            key-positions = <13 24>;
            bindings = <&sk LSHFT>;
            timeout-ms = <10>;
            layers = <0 2 3 4 6 7>;
        };

        combo_lctrl {
            key-positions = <12 23>;
            bindings = <&sk LCTRL>;
            timeout-ms = <10>;
            layers = <0 2 3 4 6 7>;
        };

        combo_lalt {
            key-positions = <11 22>;
