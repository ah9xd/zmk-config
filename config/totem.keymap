        //                timeout-ms = <25>;
        //                layers = <0 4 6 7>;
        //            };
        //            combo_rdqt {
        //                key-positions = <17 18>;
        //                bindings = <&kp DQT>;
        //		timeout-ms = <25>;
        //                layers = <2>;
        //            };
        //            combo_lapos {
        //                key-positions = <11 12>;
        //                bindings = <&kp APOS>;
        //                timeout-ms = <25>;
        //                layers = <2>;
        //            };
        //            combo_lunder {
        //                key-positions = <12 13>;
        //                bindings = <&kp UNDER>;
        //                timeout-ms = <25>;
        //                layers = <0 4 6 7>;
        //            };
        //            combo_rminus {
        //                key-positions = <16 17>;
        //                bindings = <&kp MINUS>;
        //                timeout-ms = <25>;
        //                layers = <0 4 6 7>;
        //            };
        //            combo_runder {
        //                key-positions = <16 17>;
        //                bindings = <&kp UNDER>;
        //		timeout-ms = <25>;
        //                layers = <2>;
        //            };
        //            combo_lminus {
        //                key-positions = <12 13>;
        //                bindings = <&kp MINUS>;
        //                timeout-ms = <25>;
        //                layers = <2>;
        //            };

        combo_lrbrc {
            key-positions = <1 2>;
            bindings = <&kp RBRC>;
            timeout-ms = <25>;
            layers = <2>;
        };

        combo_llbrc {
            key-positions = <1 2>;
            bindings = <&kp LBRC>;
            timeout-ms = <25>;
            layers = <0 4 6 7>;
        };

        combo_rlbrc {
            key-positions = <7 8>;
            bindings = <&kp LBRC>;
            timeout-ms = <25>;
            layers = <2>;
        };

        combo_rrbrc {
            key-positions = <7 8>;
            bindings = <&kp RBRC>;
            timeout-ms = <25>;
            layers = <0 4 6 7>;
        };

        combo_lrbkt {
            key-positions = <0 1>;
            bindings = <&kp RBKT>;
            timeout-ms = <25>;
            layers = <2>;
        };

        combo_llbkt {
            key-positions = <0 1>;
            bindings = <&kp LBKT>;
            timeout-ms = <25>;
            layers = <0 4 6 7>;
        };

        combo_rlbkt {
            key-positions = <8 9>;
            bindings = <&kp LBKT>;
            timeout-ms = <25>;
            layers = <2>;
        };

        combo_rrbkt {
            key-positions = <8 9>;
            bindings = <&kp RBKT>;
            timeout-ms = <25>;
            layers = <0 4 6 7>;
        };

        combo_lrpar {
            key-positions = <2 3>;
            bindings = <&kp RPAR>;
            timeout-ms = <25>;
            layers = <2>;
        };

        combo_llpar {
            key-positions = <2 3>;
            bindings = <&kp LPAR>;
            timeout-ms = <25>;
            layers = <0 4 6 7>;
        };

        combo_rlpar {
            key-positions = <6 7>;
            bindings = <&kp LPAR>;
            timeout-ms = <25>;
            layers = <2>;
        };

        combo_rrpar {
            key-positions = <6 7>;
            bindings = <&kp RPAR>;
            timeout-ms = <25>;
            layers = <0 4 6 7>;
        };

        combo_gam2esc {
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            timeout-ms = <50>;
            layers = <5>;
        };

        combo_caps {
            key-positions = <22 23 24>;
            bindings = <&kp CAPS>;
            timeout-ms = <50>;
            layers = <0 4 6 7>;
        };

        combo_apos {
            key-positions = <27 28 29>;
            bindings = <&kp APOS>;
            timeout-ms = <50>;
            layers = <0 4 6 7>;
        };

        combo_capsrev {
            key-positions = <27 28 29>;
            bindings = <&kp CAPS>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_aposrev {
            key-positions = <22 23 24>;
            bindings = <&kp APOS>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_lscrldn {
            key-positions = <22 23 24>;
            bindings = <&msc SCRL_DOWN>;
            timeout-ms = <50>;
            layers = <3>;
        };

        combo_rscrldn {
            key-positions = <27 28 29>;
            bindings = <&msc SCRL_DOWN>;
            timeout-ms = <50>;
            layers = <3>;
        };

        combo_lscrlup {
            key-positions = <23 24 25>;
            bindings = <&msc SCRL_UP>;
            timeout-ms = <50>;
            layers = <3>;
        };

        combo_rscrlup {
            key-positions = <26 27 28>;
            bindings = <&msc SCRL_UP>;
            timeout-ms = <50>;
            layers = <3>;
        };

        combo_lfunclayer {
            key-positions = <33 34>;
            bindings = <&sl 9>;
            timeout-ms = <50>;
            layers = <0 2 3 4 6 7>;
        };

        combo_rfunclayer {
            key-positions = <35 36>;
            bindings = <&sl 9>;
            timeout-ms = <50>;
            layers = <0 1 2 3 4 6 7>;
        };

        combo_lrevlayer {
            key-positions = <32 33>;
            bindings = <&sl 2>;
            timeout-ms = <50>;
            layers = <0 3 4 6 7>;
        };

        combo_rrevlayer {
            key-positions = <36 37>;
            bindings = <&sl 2>;
            timeout-ms = <50>;
            layers = <0 3 4 6 7>;
        };

        //combo_gamealt {
        //    key-positions = <33 34>;
        //    bindings = <&kp LALT>;
        //    timeout-ms = <50>;
        //    layers = <1 5>;
        //};
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃   BSPC    ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
       &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y      &kp U            &kp I        &kp O       &kp P
       &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G        &kp H      &mt LSHFT J      &mt LCTRL K  &mt RALT L  &mt LGUI SEMI
&kp Z  &kp Z       &kp X       &kp C        &kp V        &kp B        &kp N      &kp M            &kp COMMA    &kp DOT     &kp FSLH       &kp FSLH
                               &lt 10 ESC   &lt 6 SPACE  &lt 6 TAB    &lt 3 DEL  &lt 9 BACKSPACE  &lt 3 RET
            >;
        };

        game {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "GAME";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃    TAB    ┃     q     ┃     w     ┃     e     ┃     r     ┃   ┃     t     ┃     y     ┃     u     ┃     i     ┃     o     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   LCTRL   ┃     a     ┃     S     ┃     d     ┃     f     ┃   ┃     g     ┃     h     ┃     n     ┃     k     ┃     l     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃    ALT    ┃   SHIFT   ┃     z     ┃     x     ┃     c     ┃     v     ┃   ┃     b     ┃     n     ┃     m     ┃     ,     ┃     .     ┃      /    ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    SPC    ┃    SPC    ┃   ┃   ENTER   ┃   BSPC    ┃   ENTER   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
          &kp T      &kp Q  &kp W  &kp E      &kp R    &kp J      &kp L     &kp UP     &kp Y      &kp SEMI
          &kp LSHFT  &kp A  &kp S  &kp D      &kp F    &kp H      &kp LEFT  &kp DOWN   &kp RIGHT  &mt RGUI O
&kp LALT  &kp LCTRL  &kp Z  &kp X  &kp C      &kp V    &kp K      &kp M     &kp COMMA  &kp DOT    &kp FSLH    &kp FSLH
                            &mo 3  &kp SPACE  &mo 5    &lt 6 RET  &kp BSPC  &kp BSPC
            >;
        };

        reverse {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "REV";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃    p      ┃     o     ┃     i      ┃     u    ┃      y        ┃     t     ┃     r     ┃     e     ┃     w     ┃     q     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   ;       ┃     l     ┃     k     ┃     j     ┃     h     ┃   ┃     g     ┃     f     ┃     d     ┃     s     ┃     a     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃    ALT    ┃   /       ┃     .     ┃     ,     ┃     m     ┃     n     ┃   ┃     b     ┃     v     ┃     c     ┃     x     ┃     z     ┃      /    ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    SPC    ┃    SPC    ┃   ┃   ENTER   ┃   BSPC    ┃   ENTER   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

