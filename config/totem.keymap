#define ZMK_POINTING_DEFAULT_MOVE_VAL 2400  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define GAME 1
#define REV  2
#define NAVI 3
#define ADJ  4
#define GAM2 5
#define NUM  6
#define NUMP 7
#define FUNC 8

&mt {
    quick-tap-ms = <140>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        //combo_esc {
        //    timeout-ms = <50>;
        //    key-positions = <0 1>;
        //    bindings = <&kp ESC>;
        //};

        combo_rshft {
            key-positions = <16 27>;
            bindings = <&sk RSHFT>;
            timeout-ms = <50>;
            layers = <0 2 3 4 6 7>;
        };

        combo_rctrl {
            key-positions = <17 28>;
            bindings = <&sk RCTRL>;
            timeout-ms = <50>;
            layers = <0 2 3 4 6 7>;
        };

        combo_ralt {
            key-positions = <18 29>;
