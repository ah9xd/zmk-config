            timeout-ms = <10>;
            layers = <0 2 3 4 6 7>;
        };

        combo_lgui {
            key-positions = <10 21>;
            bindings = <&sk LGUI>;
            timeout-ms = <10>;
            layers = <0 2 3 4 6 7>;
        };

        //            combo_ldqt {
        //                key-positions = <11 12>;
        //                bindings = <&kp DQT>;
        //                timeout-ms = <25>;
        //                layers = <0 4 6 7>;
        //            };
        //            combo_rapos {
